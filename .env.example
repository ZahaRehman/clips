DATA_DIR=/data
DATABASE_URL=sqlite+aiosqlite:////data/cliping.db
REDIS_URL=redis://redis:6379/0
API_TOKEN=
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_PREFIX=
S3_ENDPOINT_URL=
MIN_FREE_BYTES=1073741824
CLEANUP_MAX_AGE_DAYS=7
CLEANUP_DELETE_PROXY=false
WATERMARK_TEXT=
WATERMARK_IMAGE=
CORS_ORIGINS=http://localhost:3001
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_MODEL_DIR=/models/whisper

MAX_SOURCE_DURATION_SEC=43200
MAX_SOURCE_BYTES=8589934592
EXPORT_WIDTH=1080
EXPORT_HEIGHT=1920
# Encode speed (see docs/PERFORMANCE_RND.md). medium + 60 fps was ~3.5x slower per short.
EXPORT_PRESET=veryfast
EXPORT_CRF=18
EXPORT_AUDIO_BITRATE=192k
# 1440 = sharper vertical shorts (slower download/encode). 1080 = faster.
SOURCE_MAX_HEIGHT=1440
EXPORT_MAX_FPS=30
PROXY_PRESET=veryfast
PROXY_MAX_FPS=30
# Finished videos up to this many seconds run as one file; longer ones are split into LIVE_CHUNK_SEC ranges.
VOD_CHUNK_THRESHOLD_SEC=1800
# Most shorts per live window (0 = only the project's clip count).
LIVE_WINDOW_MAX_CLIPS=3
CLIP_MIN_SEC=5
CLIP_MAX_SEC=180
TARGET_CLIP_COUNT=8
ALLOW_URL_INGEST=false
ALLOW_LIVE_INGEST=false
LIVE_CHUNK_SEC=300
LIVE_CHUNK_OVERLAP_SEC=20
LIVE_EDGE_LAG_SEC=20
LIVE_MAX_HOURS=8
LIVE_FOLDER_ROOT=
LIVE_STALL_SEC=180
LIVE_FOLDER_STABLE_SEC=10
YT_DLP_PATH=yt-dlp
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=90
# Phase 5: LLM_PROVIDER=gemini ranks with Gemini; post text uses Gemini whenever GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SEC=90
GEMINI_MAX_TRANSCRIPT_CHARS=300000
CHANNEL_CONTEXT=
AUTOPILOT_CLIP_COUNT=10
AUTOPILOT_CLIP_MIN_SEC=20
AUTOPILOT_CLIP_MAX_SEC=59
AUTOPILOT_TARGET_SEC=35
WORKER_JOB_TIMEOUT_SEC=21600
KEYWORD_BOOSTS=tip,mistake,secret,why,how,lesson
FONTS_DIR=/app/app/assets/fonts
ASR_ALIGNER=none

# Live now tab. Free YouTube Data API key. Leave empty and the tab says search is off.
YOUTUBE_API_KEY=

# Phase 6: leave the client id empty and YouTube posting stays off.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/backend/api/v1/youtube/callback
YOUTUBE_CATEGORY_ID=22
YOUTUBE_DEFAULT_SPACING_MIN=180

# Phase 7: leave the client key empty and TikTok posting stays off.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/api/backend/api/v1/tiktok/callback
